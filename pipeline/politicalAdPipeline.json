{
	"name": "politicalAdPipeline",
	"properties": {
		"activities": [
			{
				"name": "politicalAdWebHook",
				"type": "WebHook",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": "https://management.azure.com/subscriptions/dee7ac04-b4ba-4454-b71a-3cfc2fb97ed8/resourceGroups/nationalMM/providers/Microsoft.App/jobs/political-ad-processor-job/start?api-version=2024-03-01",
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"body": {
						"value": "@json('{\n  \"containers\": [\n    {\n      \"name\": \"political-ad-processor-job\",\n      \"image\": \"matiasmicen/nat-media-poc-streamlit-app:latest\",\n      \"command\": [\"poetry\"],\n      \"args\": [\n        \"run\",\n        \"python\",\n        \"main.py\",\n        \"sent_from_queue2.xlsx\",\n        \"$callbackUri\"\n      ],\n      \"env\": [\n        {\n          \"name\": \"AZURE_STORAGE_CONNECTION_STRING\",\n          \"secretRef\": \"azure-storage-connection\"\n        },\n        {\n          \"name\": \"GEMINI_API_KEY\",\n          \"secretRef\": \"gemini-api-key\"\n        },\n        {\n          \"name\": \"AZURE_STORAGE_KEY\",\n          \"secretRef\": \"azure-storage-key\"\n        },\n        {\n          \"name\": \"CALLBACK_URI\",\n          \"value\": \"$callbackUri\"\n        }\n      ]\n    }\n  ]\n}\n')",
						"type": "Expression"
					},
					"timeout": "00:10:00",
					"reportStatusOnCallBack": true,
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com/"
					}
				}
			}
		],
		"variables": {
			"containerPayload": {
				"type": "String"
			},
			"fileName": {
				"type": "String"
			}
		},
		"annotations": []
	}
}