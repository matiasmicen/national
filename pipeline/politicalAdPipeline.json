{
	"name": "politicalAdPipeline",
	"properties": {
		"activities": [
			{
				"name": "politicalAdJob",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://management.azure.com/subscriptions/dee7ac04-b4ba-4454-b71a-3cfc2fb97ed8/resourceGroups/nationalMM/providers/Microsoft.App/jobs/political-ad-processor-job/start?api-version=2024-03-01",
					"body": {
						"containers": [
							{
								"name": "political-ad-processor-job",
								"image": "matiasmicen/nat-media-poc-streamlit-app:latest",
								"command": [
									"poetry"
								],
								"args": [
									"run",
									"python",
									"main.py",
									"sent_from_queue2.xlsx",
									"https://your-webhook.com/complete"
								],
								"env": [
									{
										"name": "AZURE_STORAGE_CONNECTION_STRING",
										"secretRef": "azure-storage-connection"
									},
									{
										"name": "GEMINI_API_KEY",
										"secretRef": "gemini-api-key"
									},
									{
										"name": "AZURE_STORAGE_KEY",
										"secretRef": "azure-storage-key"
									}
								]
							}
						]
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com/"
					}
				}
			},
			{
				"name": "politicalAdWebHook",
				"type": "WebHook",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": "https://management.azure.com/subscriptions/dee7ac04-b4ba-4454-b71a-3cfc2fb97ed8/resourceGroups/nationalMM/providers/Microsoft.App/jobs/political-ad-processor-job/start?api-version=2024-03-01",
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"body": {
						"value": "@json('{\n  \"containers\": [\n    {\n      \"name\": \"political-ad-processor-job\",\n      \"image\": \"matiasmicen/nat-media-poc-streamlit-app:latest\",\n      \"command\": [\"poetry\"],\n      \"args\": [\n        \"run\",\n        \"python\",\n        \"main.py\",\n        \"sent_from_queue2.xlsx\",\n        \"$$[CALLBACK_URI]\"\n      ],\n      \"env\": [\n        {\"name\": \"AZURE_STORAGE_CONNECTION_STRING\", \"secretRef\": \"azure-storage-connection\"},\n        {\"name\": \"GEMINI_API_KEY\", \"secretRef\": \"gemini-api-key\"},\n        {\"name\": \"AZURE_STORAGE_KEY\", \"secretRef\": \"azure-storage-key\"},\n        {\"name\": \"CALLBACK_URI\", \"value\": \"$$[CALLBACK_URI]\"}\n      ]\n    }\n  ]\n}')",
						"type": "Expression"
					},
					"timeout": "00:10:00",
					"reportStatusOnCallBack": true,
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com/"
					}
				}
			}
		],
		"variables": {
			"containerPayload": {
				"type": "String"
			},
			"fileName": {
				"type": "String"
			}
		},
		"annotations": []
	}
}