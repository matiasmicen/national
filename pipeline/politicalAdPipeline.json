{
	"name": "politicalAdPipeline",
	"properties": {
		"activities": [
			{
				"name": "politicalAdWebHook",
				"type": "WebHook",
				"dependsOn": [
					{
						"activity": "GetCallbackURL",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": "https://management.azure.com/subscriptions/dee7ac04-b4ba-4454-b71a-3cfc2fb97ed8/resourceGroups/nationalMM/providers/Microsoft.App/jobs/political-ad-processor-job/start?api-version=2024-03-01",
					"method": "POST",
					"body": {
						"containers": [
							{
								"name": "political-ad-processor-job",
								"image": "matiasmicen/nat-media-poc-streamlit-app:latest",
								"command": [
									"poetry"
								],
								"args": [
									"run",
									"python",
									"main.py",
									"@{variables('fileName')}",
									"@{activity('GetCallbackURL').output.webhookCallbackUri}"
								],
								"env": [
									{
										"name": "AZURE_STORAGE_CONNECTION_STRING",
										"secretRef": "azure-storage-connection"
									},
									{
										"name": "GEMINI_API_KEY",
										"secretRef": "gemini-api-key"
									},
									{
										"name": "AZURE_STORAGE_KEY",
										"secretRef": "azure-storage-key"
									},
									{
										"name": "CALLBACK_URI",
										"value": "@{callBackUri}"
									}
								]
							}
						]
					},
					"timeout": "00:10:00",
					"reportStatusOnCallBack": true,
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com/"
					}
				}
			},
			{
				"name": "BuildfileName",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "fileName",
					"value": "\"sent_from_queue2.xlsx\""
				}
			},
			{
				"name": "GetCallbackURL",
				"type": "WebHook",
				"dependsOn": [
					{
						"activity": "BuildfileName",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": "https://management.azure.com/subscriptions/dee7ac04-b4ba-4454-b71a-3cfc2fb97ed8/resourceGroups/nationalMM/providers/Microsoft.App/jobs/political-ad-processor-job/start?api-version=2024-03-01",
					"method": "POST",
					"body": {
						"containers": [
							{
								"name": "political-ad-processor-job",
								"image": "matiasmicen/nat-media-poc-streamlit-app:latest",
								"command": [
									"poetry"
								],
								"args": [
									"run",
									"python",
									"main.py",
									""
								],
								"env": [
									{
										"name": "AZURE_STORAGE_CONNECTION_STRING",
										"secretRef": "azure-storage-connection"
									},
									{
										"name": "GEMINI_API_KEY",
										"secretRef": "gemini-api-key"
									},
									{
										"name": "AZURE_STORAGE_KEY",
										"secretRef": "azure-storage-key"
									}
								]
							}
						]
					},
					"timeout": "00:01:00"
				}
			}
		],
		"variables": {
			"containerPayload": {
				"type": "String"
			},
			"fileName": {
				"type": "String"
			}
		},
		"annotations": []
	}
}